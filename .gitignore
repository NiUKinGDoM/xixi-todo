tests/app.js
tests/*.png
tests/*.bmp
tests/*.log
tests/*.txt
tests/*.tmp

# 图标生成的预览图
ui/icon_preview.png

# 打包生成的 spec
*.spec

# 系统文件
Thumbs.db
desktop.ini
.DS_Store

