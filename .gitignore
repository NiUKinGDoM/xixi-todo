# 构建中间文件（dist 里的 exe 需要入库，供更新检查下载）
build/

# Python 虚拟环境
venv/
.venv/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 安装包通过 GitHub Release 分发，仓库不再存二进制
dist/*.exe
build/*.exe

